APP_NAME="MSS-DMS"
APP_ENV=local
APP_DEBUG=true
# auto utilise des URLs relatives et conserve l'adresse IP / le domaine de la requête.
APP_URL=auto
APP_BASE_PATH=
APP_TIMEZONE=Africa/Lubumbashi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mss_dms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Notifications client par e-mail (départ, arrivée, livraison).
# MAIL_DRIVER=log écrit les messages dans storage/logs/mail.log sans rien envoyer.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS, port 587), ssl (port 465) ou none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME="MSS-DMS"
